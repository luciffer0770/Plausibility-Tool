{
  "name": "PRÜF (Python + noVNC)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteEnv": {
    "DISPLAY": ":99",
    "PRUF_GEOMETRY": "1280x720",
    "PRUF_MINSIZE": "1024x600"
  },
  "postCreateCommand": "pip install --no-cache-dir -r requirements.txt",
  "postStartCommand": "nohup /usr/local/bin/start-pruf-desktop.sh </dev/null >>/tmp/pruf-desktop.log 2>&1 & sleep 3",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "noVNC — open this in browser for PRÜF",
      "visibility": "public",
      "onAutoForward": "notify"
    }
  }
}
